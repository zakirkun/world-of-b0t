FROM python:3.12-alpine

# ORIGIN-9 :: internal api surface (World Of B0t challenge 11)
# Category: Web | Difficulty: hard | Vuln: reverse-proxy path-normalization bypass

WORKDIR /app
COPY internal/server.py /app/server.py

# Flag is injected at runtime as an env var; never baked into a layer.
ENV W0B_FLAG=""
ENV PORT=9000

USER 10002
EXPOSE 9000
CMD ["python3", "server.py"]
