FROM golang:1.23-alpine AS builder
WORKDIR /src
COPY internal/ /src
RUN CGO_ENABLED=0 go build -o /status-farm .

FROM alpine:3.20
RUN adduser -D -u 10002 farm
COPY --from=builder /status-farm /usr/local/bin/status-farm

# Flag is injected at runtime as an env var; never baked into a layer.
ENV W0B_FLAG=""
USER farm
EXPOSE 9000
CMD ["/usr/local/bin/status-farm"]
